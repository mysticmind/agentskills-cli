<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Multi-targeted so the published tool works on .NET 8 LTS as well as .NET 10.
      `dnx AgentSkills` still requires .NET 10 (the dnx command itself ships with the
      10 SDK), but `dotnet tool install` succeeds on either runtime.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>AgentSkills</RootNamespace>
    <!-- AssemblyName / PackageId / ToolCommandName are all the lowercase form
         so `dnx agentskills` and `agentskills <verb>` read identically. The C#
         namespace and project/solution names stay PascalCase per .NET convention. -->
    <AssemblyName>agentskills</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentskills</ToolCommandName>
    <PackageType>DotnetTool</PackageType>
    <PackageId>agentskills</PackageId>
    <Title>AgentSkills</Title>
    <Version>0.2.0</Version>
    <Authors>Babu Annamalai</Authors>
    <Copyright>Copyright (c) 2026 Babu Annamalai</Copyright>
    <Description>Install agent skills from GitHub, NuGet, npm, or local folders into Claude Code, Cursor, Codex &amp; friends. Runs as `dnx agentskills`. A .NET port of vercel-labs/skills implementing the open Agent Skills spec.</Description>
    <PackageProjectUrl>https://github.com/mysticmind/agent-skills</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mysticmind/agent-skills</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>skills;agent-skills;ai;agents;claude;cursor;codex;opencode;dotnet-tool;dnx;nuget;npm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RollForward>LatestMajor</RollForward>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
