<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Multi-targeted so the published tool works on .NET 8 LTS as well as .NET 10.
      `dnx AgentSkills` still requires .NET 10 (the dnx command itself ships with the
      10 SDK), but `dotnet tool install` succeeds on either runtime.
      .NET 11 and later run the net10.0 build via RollForward=LatestMajor (below).
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>AgentSkills</RootNamespace>
    <!-- All three (PackageId, AssemblyName, ToolCommandName) match the
         hyphenated form. One name, one mental model: what you install is
         what you type. Users who want a shorter daily command alias it in
         their shell (see docs/getting-started/install.md). -->
    <AssemblyName>agentskills-cli</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentskills-cli</ToolCommandName>
    <PackageType>DotnetTool</PackageType>
    <PackageId>agentskills-cli</PackageId>
    <Title>AgentSkills CLI</Title>
    <Version>1.1.0</Version>
    <Authors>Babu Annamalai</Authors>
    <Copyright>Copyright (c) 2026 Babu Annamalai</Copyright>
    <Description>The .NET commandline tool for the open Agent Skills ecosystem. Install skills from GitHub, NuGet, npm, well-known endpoints, or local folders into Claude Code, Cursor, Codex, OpenCode, and any spec-compliant agent.</Description>
    <PackageProjectUrl>https://github.com/mysticmind/agentskills-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mysticmind/agentskills-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>skills;agent-skills;ai;agents;claude;cursor;codex;opencode;dotnet-tool;dnx;nuget;npm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RollForward>LatestMajor</RollForward>
    <!-- SourceLink ships in the .NET 8+ SDK; no Microsoft.SourceLink.GitHub package needed. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Credentials" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Pack the brand logo as the package icon shown on nuget.org -->
    <None Include="..\..\docs\public\logo.png" Pack="true" PackagePath="\icon.png" Visible="false" />
  </ItemGroup>

</Project>
