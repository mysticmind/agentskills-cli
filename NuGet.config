<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet.config. <clear /> resets any sources inherited from the
  user-level or machine-level config so the build is reproducible regardless
  of what feeds the developer has registered globally. All AgentSkills CLI
  build dependencies come from nuget.org; no need to inherit anything else.

  This also keeps NU1507 (multi-source + Central Package Management) from
  surfacing as a build error when the user has additional sources configured
  globally for unrelated work.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
