<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128;NU5127</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <PackageId>Sample.SkillPackage</PackageId>
    <Version>0.1.0</Version>
    <Authors>AgentSkills sample</Authors>
    <Description>A sample NuGet package shipping a single agent skill under skills/.</Description>
    <PackageTags>skills;sample</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- skills/<name>/ at the package root: the layout both AgentSkills CLI and NuGet's
         dotnet-package-skills read. %(RecursiveDir) keeps each skill's folder structure. -->
    <None Include="skills/**/*"
          Pack="true"
          PackagePath="skills/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
